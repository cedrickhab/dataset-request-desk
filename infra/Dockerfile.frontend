# Build the SPA, then serve it from nginx, which also proxies /api to Django.
# Serving both from one origin is what makes session cookies and CSRF simple:
# no CORS, no cross-site cookie rules.
FROM node:22-alpine AS build

WORKDIR /app/frontend

# npm ci installs exactly what package-lock.json pins.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend ./
RUN npm run build


# Gate stage: lint, typecheck, unit tests and build, all against a copy of the
# source inside the image. Deliberately NOT a bind mount of ./frontend -- an
# Alpine container running npm ci into a mounted directory overwrites the
# developer's node_modules with musl-linked binaries and breaks their local
# toolchain. A verification step must never be able to modify the working tree.
FROM build AS check
RUN npm run lint \
    && npm run typecheck \
    && npm run test -- --run \
    && npm run build


FROM nginx:1.29-alpine AS runtime

COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html

EXPOSE 80
