# Copy to .env and fill in. .env is gitignored and must never be committed.
# cp .env.example .env

# --- Django -------------------------------------------------------------------
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Required whenever DJANGO_DEBUG is off; the app refuses to start without it.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Leave false for local HTTP. Set true behind HTTPS so cookies get Secure.
DJANGO_SECURE_COOKIES=false

# --- Database -----------------------------------------------------------------
POSTGRES_DB=dataset_desk
POSTGRES_USER=dataset_desk
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Optional personal administrator -----------------------------------------
# Both must be set or the account is skipped; demo seeding works either way.
# Use a unique password from a password manager, at least 16 characters.
# This value is read straight into set_password and is never logged or stored
# in plaintext. Do not commit a filled-in copy of this file.
PERSONAL_ADMIN_EMAIL=
PERSONAL_ADMIN_PASSWORD=
PERSONAL_ADMIN_NAME=

# --- Tuning (defaults shown; all optional) -----------------------------------
# LOG_FORMAT=json
# LOG_LEVEL=INFO
# EXPORT_FAILURE_RATE=0.2
# EXPORT_MAX_ATTEMPTS=3
# IMPORT_MAX_UPLOAD_BYTES=10485760
# BUSINESS_TIME_ZONE=Africa/Kigali
